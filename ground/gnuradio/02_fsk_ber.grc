    label1: BER
    label10: ''
    label2: ''
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    max: '0.01'
    min: '0'
    name: '"BER medida (ultimos 100 000 bits)"'
    nconnections: '1'
    type: float
    unit1: ''
    unit10: ''
    unit2: ''
    unit3: ''
    unit4: ''
    unit5: ''
    unit6: ''
    unit7: ''
    unit8: ''
    unit9: ''
    update_time: '0.5'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1480, 600]
    rotation: 0
    state: enabled
- name: bits
  id: analog_random_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: Bits aleatorios
    max: '2'
    maxoutbuf: '0'
    min: '0'
    minoutbuf: '0'
    num_samps: '100000'
    repeat: 'True'
    type: byte
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 260]
    rotation: 0
    state: enabled
- name: comparador
  id: blocks_xor_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 1 si el bit recibido es distinto
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
